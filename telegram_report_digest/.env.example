# ── 텔레그램 계정 (리포트 채널을 읽는 쪽) ─────────────────
# https://my.telegram.org → API development tools 에서 발급
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef
# 세션 파일 이름 (tg_session.session 으로 저장됨, 외부 공유 금지)
TG_SESSION=tg_session

# 리포트가 올라오는 채널들, 쉼표로 구분 (@username 또는 -100으로 시작하는 숫자 ID)
# `python telegram_report_digest.py --login` 실행하면 구독 중인 채널 ID 목록이 나와요
SOURCE_CHANNELS=@channel_one,@channel_two,-1001234567890

# ── 텔레그램 봇 (브리핑을 보내는 쪽) ───────────────────────
# @BotFather 에서 /newbot 으로 발급
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 받을 채팅 ID. 봇에게 아무 메시지나 보낸 뒤
# https://api.telegram.org/bot<BOT_TOKEN>/getUpdates 에서 "chat":{"id": ...} 확인
CHAT_ID=123456789

# ── Claude API ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# 리포트별 요약 모델. 하루 수십 건이면 claude-haiku-4-5 로 바꾸면 비용이 크게 줄어요
# (Haiku는 PDF 100페이지까지)
REPORT_MODEL=claude-sonnet-5
# 종합 브리핑 모델 (하루 1번 호출)
DIGEST_MODEL=claude-sonnet-5

# 첫 실행 때 몇 시간 전 것까지 가져올지
LOOKBACK_HOURS=24
# 이보다 큰 PDF는 건너뜀 (API 요청 한도 32MB, base64로 1.33배 커짐)
MAX_PDF_MB=20
